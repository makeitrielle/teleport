# Use the HTTPS Render backend URL with wss:// and the Tele-port print-agent path.
WS_URL=wss://teleport-backend.onrender.com/api/printer/agent
AGENT_SECRET=copy-the-same-32-character-random-secret-used-by-the-backend
PRINTER_NAME=XP-58
# Set true only if your XP-58C cutter is enabled and you want each ticket cut.
CUT_AFTER_PRINT=false
