MONGODB_URI=mongodb://localhost:27017/teleport
PORT=4000

# Configure Resend to send email confirmation and password reset links.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Jasper Jean <auth@teleport-app.online>
APP_URL=https://tele-port-ecru.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: set APP_URL and ALLOWED_ORIGINS to the actual HTTPS site origin.
NODE_ENV=development
# Prefer serving /api through the same origin as the web app.
COOKIE_CROSS_SITE=false

# Set the same long random secret in Render and backend/print-agent/.env.
AGENT_SECRET=replace-with-a-random-secret-at-least-32-characters
PUBLIC_APP_URL=https://www.teleport-app.online
